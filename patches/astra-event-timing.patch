+void Workload::record_event_timing(const char* stage, uint64_t node_id) {
+    const char* directory = getenv("ASTRA_EVENT_TIMING_DIR");
+    if (directory == nullptr) {
+        return;
+    }
+    if (!event_timing_stream.is_open()) {
+        event_timing_stream.open(std::string(directory) + "/event_timing.rank" +
+                                 std::to_string(sys->id) + ".log");
+        if (!event_timing_stream) {
+            throw std::runtime_error("Cannot open ASTRA event timing output");
+        }
+    }
+    event_timing_stream << "ASTRA_EVENT_TIMING_V1," << sys->id << "," << node_id
+                        << "," << stage << "," << Sys::boostedTick() << ","
+                        << CLOCK_PERIOD << std::endl;
+}
